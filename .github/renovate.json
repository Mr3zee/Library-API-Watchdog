{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": ["config:recommended"],
  "enabledManagers": ["gradle", "gradle-wrapper", "npm", "github-actions", "custom.regex"],
  "automerge": false,
  "rebaseWhen": "behind-base-branch",
  "packageRules": [
    {
      "matchPackageNames": ["/^org\\.jetbrains\\.kotlin[.:]/"],
      "groupName": "Kotlin",
      "separateMajorMinor": false
    },
    {
      "description": "kotlinMin in the version catalog is the Kotlin version of the plugin-annotations build. Change it by hand. The rule matches the 2.3 line only, so change the rule with kotlinMin.",
      "matchPackageNames": ["/^org\\.jetbrains\\.kotlin\\.multiplatform[.:]/"],
      "matchCurrentVersion": "/^2\\.3\\./",
      "enabled": false
    },
    {
      "matchPackageNames": ["/^org\\.jetbrains\\.kotlin\\.compiler\\.plugin\\.devkit:/"],
      "registryUrls": ["https://packages.jetbrains.team/maven/p/compiler-plugin-dev-kit/eap"],
      "ignoreUnstable": false
    },
    {
      "matchPackageNames": ["/^@docusaurus\\//"],
      "groupName": "Docusaurus"
    },
    {
      "matchManagers": ["github-actions"],
      "matchUpdateTypes": ["minor", "patch"],
      "groupName": "GitHub Actions"
    },
    {
      "matchDepNames": ["agp8"],
      "allowedVersions": "/^8\\./"
    },
    {
      "matchDepNames": ["agp9"],
      "allowedVersions": "/^9\\./"
    }
  ],
  "customManagers": [
    {
      "customType": "regex",
      "managerFilePatterns": ["/^gradle/libs\\.versions\\.toml$/"],
      "matchStrings": ["(?:^|\\n)agp(?<major>[89])\\s*=\\s*\"(?<currentValue>[^\"]+)\""],
      "datasourceTemplate": "maven",
      "depNameTemplate": "agp{{{major}}}",
      "packageNameTemplate": "com.android.tools.build:gradle",
      "registryUrlTemplate": "https://dl.google.com/dl/android/maven2",
      "versioningTemplate": "maven"
    }
  ]
}
