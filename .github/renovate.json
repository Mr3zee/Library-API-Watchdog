{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": ["config:recommended"],
  "enabledManagers": ["gradle", "gradle-wrapper", "npm", "github-actions", "custom.regex"],
  "automerge": false,
  "rebaseWhen": "behind-base-branch",
  "packageRules": [
    {
      "description": "A Kotlin update is manual, because it needs new test-data dumps and a dev kit that supports the version.",
      "matchPackageNames": ["/^org\\.jetbrains\\.kotlin[.:]/"],
      "enabled": false
    },
    {
      "description": "The Dev kit update workflow updates the dev kit.",
      "matchPackageNames": ["/^org\\.jetbrains\\.kotlin\\.compiler\\.plugin\\.devkit:/"],
      "enabled": false
    },
    {
      "matchPackageNames": ["/^@docusaurus\\//"],
      "groupName": "Docusaurus"
    },
    {
      "matchManagers": ["github-actions"],
      "matchUpdateTypes": ["minor", "patch"],
      "groupName": "GitHub Actions"
    },
    {
      "matchDepNames": ["agp8", "agp9"],
      "groupName": "Android Gradle plugin"
    },
    {
      "matchDepNames": ["agp8"],
      "allowedVersions": "/^8\\./"
    },
    {
      "matchDepNames": ["agp9"],
      "allowedVersions": "/^9\\./"
    },
    {
      "description": "The Gradle wrapper and the Gradle plugins of Gradle Inc.",
      "matchManagers": ["gradle-wrapper"],
      "groupName": "Gradle"
    },
    {
      "matchPackageNames": ["/^com\\.gradle[.:]/"],
      "groupName": "Gradle"
    }
  ],
  "customManagers": [
    {
      "customType": "regex",
      "managerFilePatterns": ["/^gradle/libs\\.versions\\.toml$/"],
      "matchStrings": ["(?:^|\\n)agp(?<major>[89])\\s*=\\s*\"(?<currentValue>[^\"]+)\""],
      "datasourceTemplate": "maven",
      "depNameTemplate": "agp{{{major}}}",
      "packageNameTemplate": "com.android.tools.build:gradle",
      "registryUrlTemplate": "https://dl.google.com/dl/android/maven2",
      "versioningTemplate": "maven"
    }
  ]
}
